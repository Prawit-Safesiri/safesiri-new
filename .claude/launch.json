{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safeact-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "safeact-web",
        "start"
      ],
      "port": 8125,
      "url": "http://localhost:8125"
    },
    {
      "name": "safeact-web (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "safeact-web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "safesiri-new",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 8124,
      "url": "http://localhost:8124"
    }
  ]
}
