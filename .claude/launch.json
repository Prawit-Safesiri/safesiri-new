{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safeact-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "safeact-web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "safeact-web (production build)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd safeact-web && npm run build && npx vite preview --port 4173 --strictPort"],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "safesiri-new",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 8124,
      "url": "http://localhost:8124"
    }
  ]
}
